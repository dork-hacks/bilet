#!/usr/bin/env bash
# labctl: turn this Pi's simulated weak services on and off, and show them on the LEDs.
#
#   labctl status            what runs on this Pi, with catalog codes and points
#   labctl state             the same as "SERVICE on|off [default]" lines (for the switch helper)
#   labctl list              every service, with the role it belongs to by default
#   labctl presets           the devices this Pi can play (camera, hub, printer, ...)
#   sudo labctl fix SVC      turn a weak service off (the "fix" in the before/after demo)
#   sudo labctl break SVC    turn it on; any service works on any Pi (#155)
#   sudo labctl preset NAME  play another device: its services on, everything else off
#   sudo labctl reset        back to this Pi's preset (the default lab scores 25)
#   sudo labctl leds         refresh the LEDs: blinking red = weak service on, steady green = all fixed
#   sudo labctl leds-restore give the LEDs back to the system
set -euo pipefail

LAB_DIR=${LAB_DIR:-/opt/lab}
SERVICES=${LAB_SERVICES:-$LAB_DIR/services.tsv}
PRESETS=${LAB_PRESETS:-$LAB_DIR/presets.tsv}
ROLE_FILE=${LAB_ROLE_FILE:-/etc/lab/role}
PRESET_FILE=${LAB_PRESET_FILE:-/etc/lab/preset}
LED_ROOT=${LAB_LED_ROOT:-/sys/class/leds}  # a fake folder in the offline tests (#126)

die() { echo "labctl: $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "run with sudo: sudo labctl $*"; }

role() {
  [[ -r $ROLE_FILE ]] || die "no role set ($ROLE_FILE missing). Run lab/setup.sh first."
  local r; r=$(<"$ROLE_FILE")
  [[ $r =~ ^(camera|server|hub)$ ]] || die "bad role '$r' in $ROLE_FILE"
  echo "$r"
}

# Print the services.tsv rows (without comments) for one role, or all roles.
rows() { awk -F'\t' -v r="${1:-}" '!/^#/ && NF >= 8 && (r == "" || $2 == r)' "$SERVICES"; }

row_for() {
  local line; line=$(rows | awk -F'\t' -v s="$1" '$1 == s')
  [[ -n $line ]] || die "'$1' is not a lab service. Try: labctl list"
  echo "$line"
}

# --- presets (#155): which device this Pi plays ------------------------------
# camera, server and hub are the roles' default-on rows in services.tsv. presets.tsv adds
# more devices (preset<TAB>services<TAB>description); "custom" starts with nothing on.

preset_names() {
  printf '%s\n' camera server hub
  [[ -r $PRESETS ]] && awk -F'\t' '!/^#/ && NF >= 3 { print $1 }' "$PRESETS"
  return 0
}

valid_preset() { [[ $1 =~ ^[a-z][a-z0-9-]{0,15}$ ]] && preset_names | grep -qx -- "$1"; }

preset() { # the active preset: /etc/lab/preset, else the role setup.sh installed
  local p=""
  [[ -r $PRESET_FILE ]] && p=$(<"$PRESET_FILE")
  [[ -n $p ]] || p=$(role)
  valid_preset "$p" || die "bad preset '$p' in $PRESET_FILE. Try: labctl presets"
  echo "$p"
}

preset_services() { # NAME -> one service per line
  case $1 in
    camera | server | hub) rows "$1" | awk -F'\t' '$8 == "on" { print $1 }' ;;
    *) awk -F'\t' -v p="$1" '!/^#/ && NF >= 3 && $1 == p { n = split($2, s, ","); for (i = 1; i <= n; i++) if (s[i] != "-") print s[i] }' "$PRESETS" ;;
  esac
}

in_preset() { preset_services "$2" | grep -qx -- "$1"; } # service preset

# --- identity (hub only): random MAC + no DHCP hostname -> UNKNOWN_DEVICE ----

wifi_connection() {
  nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
    | awk -F: '$2 == "802-11-wireless" { print $1; exit }'
}

identity_active() {
  command -v nmcli >/dev/null || return 1
  local con; con=$(wifi_connection); [[ -n $con ]] || return 1
  local mac host
  mac=$(nmcli -g 802-11-wireless.cloned-mac-address connection show "$con")
  host=$(nmcli -g ipv4.dhcp-send-hostname connection show "$con")
  # Older NetworkManager prints "no"; 1.52 (Debian trixie) prints the ternary "0".
  [[ $mac =~ ^(stable|random)$ && $host =~ ^(no|0)$ ]]
}

identity_set() { # on|off, reconnect yes|no
  command -v nmcli >/dev/null || die "nmcli not found (NetworkManager is needed for the identity toggle)"
  local con; con=$(wifi_connection)
  [[ -n $con ]] || die "no active Wi-Fi connection; join the team hotspot first"
  if [[ $1 == on ]]; then
    # "stable": a locally administered MAC (so no vendor) that stays the same across
    # reboots, so history doesn't see a new device after every restart.
    nmcli connection modify "$con" 802-11-wireless.cloned-mac-address stable \
      ipv4.dhcp-send-hostname no ipv6.dhcp-send-hostname no
    systemctl disable --now avahi-daemon.service avahi-daemon.socket >/dev/null 2>&1 || true
  else
    nmcli connection modify "$con" 802-11-wireless.cloned-mac-address permanent \
      ipv4.dhcp-send-hostname yes ipv6.dhcp-send-hostname yes
    # Undo the avahi switch-off above, or <hostname>.local stays unresolvable.
    systemctl enable --now avahi-daemon.socket avahi-daemon.service >/dev/null 2>&1 || true
  fi
  if [[ $2 == yes ]]; then
    echo "Reconnecting '$con' in 3 s to apply the new identity. An SSH session over Wi-Fi will drop;"
    echo "the Pi may get a new IP address (check the hotspot's client list)."
    systemd-run --quiet --on-active=3 nmcli connection up "$con" >/dev/null
  else
    echo "Identity set to '$1'. It takes effect when the Wi-Fi reconnects (or after a reboot)."
  fi
}

# --- services ----------------------------------------------------------------

is_on() { # kind unit service
  case $1 in
    identity) identity_active ;;
    *) systemctl is-active --quiet "$2" ;;
  esac
}

unit_installed() { systemctl cat "$1" >/dev/null 2>&1; }

set_service() { # on|off kind unit service reconnect
  local want=$1 kind=$2 unit=$3 svc=$4 reconnect=${5:-yes}
  case $kind in
    identity)
      # Only touch the Wi-Fi when the state changes: every change reconnects it, and a
      # preset or reset turns this row off on every Pi that doesn't play the hub.
      if [[ $want == on ]]; then identity_active && return 0; else identity_active || return 0; fi
      identity_set "$want" "$reconnect"
      ;;
    fake | real)
      if ! unit_installed "$unit"; then
        [[ $want == off ]] && return 0
        die "$svc needs $unit, which isn't installed. Run: sudo lab/setup.sh $(role) --with-packages"
      fi
      if [[ $want == on ]]; then
        systemctl enable --now --quiet "$unit"
      else
        systemctl disable --now --quiet "$unit"
      fi
      ;;
  esac
}

# --- LEDs ----------------------------------------------------------------------

# Prints nothing when there's no such LED, and still succeeds: under set -e a failing
# $(led_path ...) would end `labctl fix` with exit 1 after the fix was done.
led_path() { local n; for n in "$@"; do [[ -d $LED_ROOT/$n ]] && { echo "$LED_ROOT/$n"; return 0; }; done; return 0; }

led() { # path trigger [brightness]
  [[ -n $1 && -w $1/trigger ]] || return 0
  echo "$2" >"$1/trigger" 2>/dev/null || return 0
  if [[ $2 == timer ]]; then
    echo 250 >"$1/delay_on"; echo 250 >"$1/delay_off"
  elif [[ $2 == none ]]; then
    echo "${3:-0}" >"$1/brightness"
  fi
}

update_leds() {
  local green red weak=0 svc kind unit
  green=$(led_path ACT led0); red=$(led_path PWR led1)
  [[ -n $green || -n $red ]] || { echo "No on-board LEDs found; skipping."; return 0; }
  while IFS=$'\t' read -r svc _ kind unit _; do
    if is_on "$kind" "$unit" "$svc"; then weak=1; break; fi
  done < <(rows)
  if (( weak )); then
    led "$green" none 0; led "$red" timer
    echo "LEDs: blinking red (a weak service is on)"
  else
    led "$red" none 0; led "$green" default-on
    echo "LEDs: steady green (all fixed)"
  fi
}

# --- commands ------------------------------------------------------------------

# lab/verify --status-file reads this output (labcheck.parse_status): keep the "Role:"
# line and the state as the last words of each row.
cmd_status() {
  local p r total=0 svc role kind unit port codes points state mark on
  p=$(preset); r=$(role)
  printf 'Role: %s\nPreset: %s\n\n%-10s %-9s %-32s %6s  %-6s  %s\n' "$r" "$p" SERVICE PORT CODES POINTS PRESET STATE
  # This Pi's services: its role's rows, its preset's, and anything else that is on.
  while IFS=$'\t' read -r svc role kind unit port codes points _; do
    on=no; is_on "$kind" "$unit" "$svc" && on=yes
    mark=-; in_preset "$svc" "$p" && mark=yes
    [[ $on == yes || $mark == yes || $role == "$r" ]] || continue
    if [[ $on == yes ]]; then
      state="ON (weak)"; total=$((total + points))
    elif [[ $kind != identity ]] && ! unit_installed "$unit"; then
      state="not installed"
    else
      state="off (fixed)"
    fi
    printf '%-10s %-9s %-32s %6s  %-6s  %s\n' "$svc" "$port" "$codes" "$points" "$mark" "$state"
  done < <(rows)
  printf '\nPoints from this Pi: %d (plus SSH_OPEN, 0 points, for the admin SSH server)\n' "$total"
  echo "Network score = max(0, 100 - points from all the lab Pis)."
}

cmd_state() {
  # The lab manager asks for this every few seconds, so it uses one systemctl call for all
  # units and reads the preset once, instead of one call per service.
  local p defaults svc kind unit on i
  local svcs=() kinds=() units=() real=() active=()
  local -A unit_state=()
  p=$(preset)
  defaults=$(preset_services "$p")
  echo "preset $p"
  while IFS=$'\t' read -r svc _ kind unit _; do
    svcs+=("$svc"); kinds+=("$kind"); units+=("$unit")
    [[ $kind == identity ]] || real+=("$unit")
  done < <(rows)
  if ((${#real[@]})); then
    mapfile -t active < <(systemctl is-active "${real[@]}" 2>/dev/null || true)
    for i in "${!real[@]}"; do unit_state[${real[i]}]=${active[i]:-unknown}; done
  fi
  for i in "${!svcs[@]}"; do
    if [[ ${kinds[i]} == identity ]]; then
      if identity_active; then on=on; else on=off; fi
    elif [[ ${unit_state[${units[i]}]} == active ]]; then on=on; else on=off; fi
    if grep -qx -- "${svcs[i]}" <<<"$defaults"; then echo "${svcs[i]} $on default"; else echo "${svcs[i]} $on"; fi
  done
}

cmd_presets() {
  local name list
  while read -r name; do
    list=$(preset_services "$name" | paste -sd, -)
    printf '%-12s %s\n' "$name" "${list:-(nothing on)}"
  done < <(preset_names)
}

cmd_list() {
  printf '%-10s %-7s %-9s %-32s %6s  %s\n' SERVICE ROLE PORT CODES POINTS DEFAULT
  rows | awk -F'\t' '{ printf "%-10s %-7s %-9s %-32s %6s  %s\n", $1, $2, $5, $6, $7, $8 }'
}

# Another service that is on and uses the same port (two web pages can't share port 80).
port_taken_by() { # service port
  local svc kind unit port
  [[ $2 == - ]] && return 1
  while IFS=$'\t' read -r svc _ kind unit port _; do
    [[ $svc != "$1" && $port == "$2" ]] && is_on "$kind" "$unit" "$svc" && { echo "$svc"; return 0; }
  done < <(rows)
  return 1
}

cmd_toggle() { # on|off service
  local line svc kind unit port other
  line=$(row_for "$2")
  IFS=$'\t' read -r svc _ kind unit port _ <<<"$line"
  if [[ $1 == on ]] && other=$(port_taken_by "$svc" "$port"); then
    die "$svc needs $port, which $other already uses. Turn $other off first."
  fi
  set_service "$1" "$kind" "$unit" "$svc" yes
  echo "$svc: $([[ $1 == on ]] && echo 'ON (weak)' || echo 'off (fixed)')"
  update_leds
}

cmd_reset() { # apply the active preset: its services on, every other service off
  local p svc kind unit want
  p=$(preset)
  # Everything off first, so a preset never trips over a port the old one held.
  while IFS=$'\t' read -r svc _ kind unit _; do
    in_preset "$svc" "$p" || set_service off "$kind" "$unit" "$svc" "${LAB_RECONNECT:-yes}" </dev/null
  done < <(rows)
  while IFS=$'\t' read -r svc _ kind unit _; do
    in_preset "$svc" "$p" && set_service on "$kind" "$unit" "$svc" "${LAB_RECONNECT:-yes}" </dev/null
  done < <(rows)
  update_leds
  cmd_status
}

cmd_preset() { # NAME
  valid_preset "$1" || die "unknown preset '$1'. Try: labctl presets"
  echo "$1" >"$PRESET_FILE"
  cmd_reset
}

main() {
  local cmd=${1:-status}
  case $cmd in
    status) cmd_status ;;
    state) cmd_state ;;
    list) cmd_list ;;
    presets) cmd_presets ;;
    preset) [[ $# -eq 2 ]] || die "usage: sudo labctl preset NAME"; need_root "$@"; cmd_preset "$2" ;;
    fix) [[ $# -eq 2 ]] || die "usage: sudo labctl fix SERVICE"; need_root "$@"; cmd_toggle off "$2" ;;
    break) [[ $# -eq 2 ]] || die "usage: sudo labctl break SERVICE"; need_root "$@"; cmd_toggle on "$2" ;;
    reset) need_root "$@"; cmd_reset ;;
    leds) need_root "$@"; update_leds ;;
    leds-restore)
      need_root "$@"
      led "$(led_path ACT led0)" mmc0; led "$(led_path PWR led1)" default-on
      echo "LEDs given back to the system." ;;
    -h | --help | help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd'. Try: labctl help" ;;
  esac
}

main "$@"
