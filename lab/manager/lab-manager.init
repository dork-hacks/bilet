#!/bin/sh /etc/rc.common
# Lab manager (#155) on the OpenWrt router (the Pi 5). Installed as /etc/init.d/lab-manager
# by setup_openwrt.sh. It listens on 127.0.0.1:8090 (open it through an SSH tunnel), or on the
# hotspot address in /etc/lab-manager/bind (setup_openwrt.sh --hotspot), with a sign-in.

START=99
STOP=10
USE_PROCD=1

start_service() {
	local bind=127.0.0.1
	[ -s /etc/lab-manager/bind ] && read -r bind < /etc/lab-manager/bind
	procd_open_instance
	procd_set_param command /usr/bin/python3 -I /opt/lab-manager/manager.py \
		--bind "$bind" --port 8090 \
		--config /etc/lab-manager/pis.conf --lab-dir /opt/lab-manager \
		--state-dir /etc/lab-manager/state --ssh-client dropbear
	procd_set_param user labmanager
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
