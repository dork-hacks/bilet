# Copy to .env and fill in locally. Never commit .env (NFR-01).

# AI layer (MASTERPLAN.md §5.2). Leave LLM_PROVIDER empty or "none" to use built-in text only.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Only for LLM_PROVIDER=ollama (default http://127.0.0.1:11434)
LLM_OLLAMA_URL=

# Where history and the device-key salt are stored (default: ./data)
TOOL_DATA_DIR=
